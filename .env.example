# Copy to .env and fill in. The API key is only used for optional enrichment,
# leech example generation, and sentence pattern tagging — never for core reviews.
ANTHROPIC_API_KEY=
# Optional: override the enrichment model (default: claude-haiku-4-5-20251001)
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Optional: API server port (default 5178)
PORT=5178

# Laoshi (the teacher) runs on a LOCAL Qwen via Ollama. Default qwen3.5:latest
# (~9.7B) is chosen for Mandarin quality + responsive live turns. For richer,
# steadier dialogue on a capable machine, pull and point at a larger Qwen, e.g.:
#   ollama pull qwen2.5:14b   (or qwen2.5:32b)
# then set QWEN_MODEL=qwen2.5:14b. Bigger = better wording but slower per turn.
# QWEN_MODEL=qwen3.5:latest
# Optional: cloud fallback if Ollama is down (Alibaba DashScope, OpenAI-compatible)
# DASHSCOPE_API_KEY=
# DASHSCOPE_MODEL=qwen-plus
