# Copy to .env and fill in. The API key is only used for optional enrichment,
# leech example generation, and sentence pattern tagging — never for core reviews.
ANTHROPIC_API_KEY=
# Optional: override the enrichment model (default: claude-haiku-4-5-20251001)
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Optional: API server port (default 5178)
PORT=5178
