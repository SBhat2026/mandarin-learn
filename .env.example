# Copy to .env and fill in. The API key is only used for optional enrichment,
# leech example generation, and sentence pattern tagging — never for core reviews.
ANTHROPIC_API_KEY=
# Optional: override the enrichment model (default: claude-haiku-4-5-20251001)
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Invisible-pass model tiers (Director blueprint, harvest, understanding). The in-app
# gear toggle switches a user between FAST and RICH per conversation, no restart.
#   FAST = cheap default (Haiku). RICH = richer planner (Sonnet).
# If CLAUDE_MODEL_RICH is left BLANK, choosing "rich" transparently uses FAST.
CLAUDE_MODEL_FAST=claude-haiku-4-5-20251001
CLAUDE_MODEL_RICH=claude-sonnet-5

# Optional: API server port (default 5178)
PORT=5178

# Laoshi (the teacher) runs on a LOCAL Qwen via Ollama. Default qwen3.5:latest
# (~9.7B) is chosen for Mandarin quality + responsive live turns. For richer,
# steadier dialogue on a capable machine, pull and point at a larger Qwen, e.g.:
#   ollama pull qwen2.5:14b   (or qwen2.5:32b)
# then set QWEN_MODEL=qwen2.5:14b. Bigger = better wording but slower per turn.
# QWEN_MODEL=qwen3.5:latest
# Ollama's default context is 4096 tokens, which the teacher prompt (persona +
# blueprint + the learner's known words + history) overruns — a truncated prompt
# comes back as an EMPTY turn. Raise it if you enlarge the prompt further.
# OLLAMA_NUM_CTX=8192
# Optional: cloud fallback if Ollama is down (Alibaba DashScope, OpenAI-compatible)
# DASHSCOPE_API_KEY=
# DASHSCOPE_MODEL=qwen-plus

# OpenRouter path (wired but INERT). Off unless USE_OPENROUTER=true. See docs/openrouter.md.
# USE_OPENROUTER=false
# OPENROUTER_API_KEY=
# Prefer an INSTRUCT model. Reasoning models (e.g. qwen/qwen3-235b-a22b) spend their
# budget thinking, answer in `reasoning` rather than `content`, and take minutes per
# turn — the app now falls through to the local model when that happens, but the
# conversation is much better with a model that just answers.
# OPENROUTER_MODEL=qwen/qwen3-235b-a22b-2507   # instruct only — a reasoning model returns junk (docs/openrouter.md)
# Abandon a slow remote turn after this long and use the local model instead.
# OPENROUTER_TIMEOUT_MS=45000
